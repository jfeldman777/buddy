{
  "name": "buddy",
  "version": "0.0.1",
  "private": true,
  "description": "Buddy — персональный ИИ-партнёр. Опыт трудных побед.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node tools/serve.mjs",
    "qr": "node tools/make-qr.mjs",
    "bump": "node tools/bump-version.mjs",
    "test": "node --test \"tests/**/*.test.mjs\" \"server/test/**/*.test.mjs\"",
    "api:dev": "wrangler dev --config server/wrangler.toml --port 8787",
    "api:migrate:local": "wrangler d1 migrations apply buddy-db --local --config server/wrangler.toml"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3"
  }
}
