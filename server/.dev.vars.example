# Copy to server/.dev.vars for `npm run api:dev`. server/.dev.vars is not committed.
RP_ID="localhost"
ALLOWED_ORIGINS="http://localhost:8080"
RECOVERY_PEPPER="<любая длинная случайная строка для разработки>"
# Cloudflare's public test secret: Turnstile always passes. Never use it in production.
TURNSTILE_SECRET="<тестовый секрет Turnstile из документации Cloudflare>"
# OpenAI — только для DCB и будущего Buddy. Никогда не коммитить настоящее значение.
# Подставьте ключ локально в server/.dev.vars (этот файл-пример ключ не содержит).
# OPENAI_API_KEY=
# Необязательно: модель, если у ключа нет gpt-4o-mini (например gpt-4.1-mini или gpt-4o).
# OPENAI_MODEL=gpt-4.1-mini
